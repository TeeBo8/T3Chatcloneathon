# Copie ce fichier vers .env.local et ajoute tes vraies valeurs

# Base de données Vercel Postgres
# Obtient cette valeur depuis ton dashboard Vercel > Storage > ta base de données
POSTGRES_URL="postgresql://..."

# AI PROVIDER (Groq)
GROQ_API_KEY="ta-clé-api-groq-ici"

# Clerk Authentication
# Obtient ces clés depuis clerk.com > ton projet > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..." 